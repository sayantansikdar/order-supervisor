# Postgres (Supabase connection string also works)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/order_supervisor

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=order-supervisor

# LLM — optional. Leave ANTHROPIC_API_KEY empty to run the fully-working
# deterministic mock agent (no external calls). Set USE_LLM=auto to use the
# real model whenever a key is present.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
USE_LLM=auto

# Turns before continue_as_new (keeps Temporal history bounded). Lower to demo it.
CONTINUE_AS_NEW_AFTER=200
